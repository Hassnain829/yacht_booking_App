APP_NAME="Chicago Yacht Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=America/Chicago

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yacht_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS) also sets (PLAN §8.1):
# SESSION_SECURE_COOKIE=true   (already the default when APP_ENV=production)
# SESSION_COOKIE=__Host-cyb_session
ADMIN_IDLE_MINUTES=30

# Only behind a proxy / CDN that terminates SSL (e.g. Cloudflare): its IP ranges, comma separated.
# Leave empty on plain Namecheap hosting, so X-Forwarded-* headers are ignored (PLAN §8.3).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@chicagoyachtbooking.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Card payments (PLAN §8.4, 4.5). Without STRIPE_SECRET the local site uses the fake gateway (a test card form,
# no money moves; refused in production). Webhook secret: `stripe listen --forward-to localhost:8000/stripe/webhook`
# locally, or the endpoint's signing secret from the Stripe dashboard.
PAYMENTS_DRIVER=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
